# Public canonical domain used for sitemap, canonical URLs, and hreflang links.
SITE_URL=https://REPLACE-WITH-DOMAIN
# Set false for non-indexable preview/staging builds.
SITE_INDEXABLE=false
# Public reCAPTCHA site key. The secret key belongs to the backend only.
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=6LcnCwYuAAAAAHCB_bjK5EF9KbMqGlwSuqQwGEBr
# Public API base URL, no trailing slash. Never put tokens or secrets here.
NUXT_PUBLIC_API_BASE_URL=https://api.example.com